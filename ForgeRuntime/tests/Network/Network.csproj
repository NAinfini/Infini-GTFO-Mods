<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings><CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>Network</AssemblyName>
    <!-- No AllowUnsafeBlocks: the host project compiles Network/** without it, so the rig must not let an unsafe
         construct in either — a test-only permission would hide the constraint that shapes the storage. -->
    <!-- CS0436: the project references the shipped GTFO-API so `SNetwork.SNet_ChannelType` is the real enum, while
         GtfoApiDoubles.cs supplies the network surface itself. The local definition is the intended one. -->
    <NoWarn>CS0436</NoWarn>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The pure logic layer plus the transport adapter, compiled here against the API doubles below. The host
         project compiles the same files against the real GTFO-API and SNet assemblies, and the binding's decisions
         are pure so the same rig drives them: the game-facing half (NetworkBinding.cs) reads SNet and stays out. -->
    <Compile Include="../../Network/**/*.cs" Link="Network/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../GameBindings/NetworkBinding.Logic.cs" Link="GameBindings/NetworkBinding.Logic.cs" />
    <Reference Include="GTFO-API" HintPath="$(GTFOBepInExPath)/plugins/GTFO-API.dll" />
    <Reference Include="SNet_ASM" HintPath="$(GTFOBepInExPath)/interop/SNet_ASM.dll" />
  </ItemGroup>
  <Target Name="ValidateReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GTFOBepInExPath)/plugins/GTFO-API.dll')" Text="Set GTFO_BEPINEX_PATH to existing local compile references." />
  </Target>
</Project>
