<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="ValidateGTFOBepInExPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GTFOBepInExPath)' == '' or !Exists('$(GTFOBepInExPath)\core\SemanticVersioning.dll')"
           Text="Set GTFO_BEPINEX_PATH or pass /p:GTFOBepInExPath=... with the profile BepInEx directory." />
  </Target>
  <ItemGroup>
    <Compile Include="../../ProjectInspectionSession.cs" Link="ProjectInspectionSession.cs" />
    <Compile Include="../../ProjectChecks.cs" Link="ProjectChecks.cs" />
    <Compile Include="../../ProjectObjectReferences.cs" Link="ProjectObjectReferences.cs" />
    <Compile Include="../../DiagnosticLogClassifier.cs" Link="DiagnosticLogClassifier.cs" />
    <Compile Include="../../DiagnosticsReport.cs" Link="DiagnosticsReport.cs" />
    <Reference Include="SemanticVersioning" HintPath="$(GTFOBepInExPath)\core\SemanticVersioning.dll" />
  </ItemGroup>
</Project>
