<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ForgeRuntime</AssemblyName>
    <RootNamespace>ForgeRuntime</RootNamespace>
    <Version>1.2.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>

  <Target Name="ValidateGTFOBepInExPath" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(GTFOBepInExPath)' == '' or !Exists('$(GTFOBepInExPath)\core\BepInEx.Core.dll')"
      Text="Set GTFO_BEPINEX_PATH or pass /p:GTFOBepInExPath=... with the path to the profile's BepInEx directory." />
  </Target>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="Framework\**\*.cs" />
    <ProjectReference Include="Framework\ForgeRuntime.Framework.csproj" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GTFOBepInExPath)\core\0Harmony.dll" Private="false" />
    <Reference Include="BepInEx.Core" HintPath="$(GTFOBepInExPath)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.Common" HintPath="$(GTFOBepInExPath)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GTFOBepInExPath)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(GTFOBepInExPath)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GTFOBepInExPath)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GTFOBepInExPath)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="GameData-ASM" HintPath="$(GTFOBepInExPath)\interop\GameData-ASM.dll" Private="false" />
    <Reference Include="Modules-ASM" HintPath="$(GTFOBepInExPath)\interop\Modules-ASM.dll" Private="false" />
    <Reference Include="CellSound-ASM" HintPath="$(GTFOBepInExPath)\interop\CellSound-ASM.dll" Private="false" />
    <Reference Include="SemanticVersioning" HintPath="$(GTFOBepInExPath)\core\SemanticVersioning.dll" Private="false" />
    <Reference Include="SNet_ASM" HintPath="$(GTFOBepInExPath)\interop\SNet_ASM.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GTFOBepInExPath)\interop\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GTFOBepInExPath)\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="DropServerSDK-ASM" HintPath="$(GTFOBepInExPath)\interop\DropServerSDK-ASM.dll" Private="false" />
    <Reference Include="GlobalFramework-ASM" HintPath="$(GTFOBepInExPath)\interop\GlobalFramework-ASM.dll" Private="false" />
    <Reference Include="Utils-ASM" HintPath="$(GTFOBepInExPath)\interop\Utils-ASM.dll" Private="false" />
  </ItemGroup>
</Project>
