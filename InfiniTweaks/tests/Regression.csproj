    <Compile Include="..\MarkerVisuals.cs" Link="MarkerVisuals.cs" />
    <Compile Include="..\MarkerPresentation.cs" Link="MarkerPresentation.cs" />
    <Compile Include="..\MarkerOwnership.cs" Link="MarkerOwnership.cs" />
