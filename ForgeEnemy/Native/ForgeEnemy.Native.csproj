<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ForgeEnemy.Native</AssemblyName><RootNamespace>ForgeEnemy.Native</RootNamespace>
    <Version>1.0.0</Version><IsPackable>false</IsPackable>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeAssembly)') or !Exists('$(ForgeFrameworkAssembly)')"
      Text="Pass explicit ForgeRuntimeAssembly and ForgeFrameworkAssembly paths from a successful host build." />
    <Error Condition="!Exists('$(GTFOBepInExPath)/core/BepInEx.Core.dll')"
      Text="Set GTFOBepInExPath or GTFO_BEPINEX_PATH to existing local compilation references." />
  </Target>
  <ItemGroup>
    <Compile Include="Plugin.cs;EnemyPluginSession.cs;EnemySpawnRequirementSource.cs;EnemyHookInstall.cs;Enemy*Hooks.cs;EnemyModule*.cs;EnemyActionFamilies.cs;EnemyControlActions.cs;EnemyCombatActions.cs;GlueActions.cs;GlueFacts.cs;EnemyBehaviorNative.cs;EnemyBehaviorLedger.cs;EnemyBehaviorActions.cs;EnemyWaveModule.cs;EnemyNodeEffectActions.cs;EnemyNodeFacts.cs;EnemyNodeRegistration.cs;EnemyNodeValueReads.cs;EnemySelector.cs;EnemyAttackInstanceFacts.cs;EnemyWaveFacts.cs;EnemyProfileContract.cs;EnemyProfileActions.cs;Observation/*.cs" />
    <!-- The spawn requirement derivation is game-independent, but the runtime data source in this assembly
         feeds it, so the one source is compiled here instead of loading the managed helper assembly. -->
    <Compile Include="../Spawn/EnemySpawnRequirements.cs" Link="Spawn/EnemySpawnRequirements.cs" />
    <!-- The node-list family's contracts: the query rows, the three action rows and the two trigger rows this
         provider declares, plus the rows of the action families the same registration carries (enemy control,
         combat, foam, behaviour) and the wave trigger rows. Compiled here for the same reason the selector
         declaration is — this assembly references exactly the host and the SDK, so the rows it registers cannot
         drift from a second copy. -->
    <Compile Include="../EnemyNode*Contract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../EnemyCombatContract.cs;../GlueContract.cs;../EnemyBehaviorContract.cs;../EnemyWaveContract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../EnemySelectorContract.cs" Link="EnemySelectorContract.cs" />
    <Compile Include="../AttackInstanceContract.cs" Link="AttackInstanceContract.cs" />
    <Compile Include="../ModuleDefinition.cs" Link="ModuleDefinition.cs" />
    <Compile Include="../EnemyControlContract.cs;../EnemyRegistration.cs" Link="%(Filename)%(Extension)" />
    <!-- One domain-owned receiver split across partials; no duplicate runtime provider. -->
    <Reference Include="ForgeRuntime" HintPath="$(ForgeRuntimeAssembly)" Private="false" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeFrameworkAssembly)" Private="false" />
    <Reference Include="BepInEx.Core" HintPath="$(GTFOBepInExPath)/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GTFOBepInExPath)/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GTFOBepInExPath)/core/0Harmony.dll" Private="false" />
    <Reference Include="GTFO-API" HintPath="$(GTFOBepInExPath)/plugins/GTFO-API.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GTFOBepInExPath)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GTFOBepInExPath)/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(GTFOBepInExPath)/interop/UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GTFOBepInExPath)/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="Modules-ASM" HintPath="$(GTFOBepInExPath)/interop/Modules-ASM.dll" Private="false" />
    <Reference Include="GameData-ASM" HintPath="$(GTFOBepInExPath)/interop/GameData-ASM.dll" Private="false" />
    <Reference Include="GlobalFramework-ASM" HintPath="$(GTFOBepInExPath)/interop/GlobalFramework-ASM.dll" Private="false" />
    <Reference Include="Shards-ASM" HintPath="$(GTFOBepInExPath)/interop/Shards-ASM.dll" Private="false" />
    <Reference Include="SNet_ASM" HintPath="$(GTFOBepInExPath)/interop/SNet_ASM.dll" Private="false" />
    <Reference Include="Utils-ASM" HintPath="$(GTFOBepInExPath)/interop/Utils-ASM.dll" Private="false" />
  </ItemGroup>
</Project>
