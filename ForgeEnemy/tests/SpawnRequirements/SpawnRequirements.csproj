<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework><IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="RequireSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ForgeFrameworkAssembly)' == '' or !Exists('$(ForgeFrameworkAssembly)')"
      Text="Pass -p:ForgeFrameworkAssembly=... with an explicitly built production SDK." />
  </Target>
  <ItemGroup>
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeFrameworkAssembly)" />
    <!-- The package's whole native compile set, the same list `ForgeEnemy/Native/ForgeEnemy.Native.csproj` compiles,
         because the dependency walk reads the rows the real provider registers: the module it registers is the entire
         provider, and a file that list leaves out is a member `EnemyModule` names and does not compile. The game
         types those sources read are doubles here rather than interop references. -->
    <Compile Include="../../Native/Plugin.cs;../../Native/EnemyPluginSession.cs;../../Native/EnemySpawnRequirementSource.cs;../../Native/EnemyHookInstall.cs;../../Native/Enemy*Hooks.cs;../../Native/EnemyModule*.cs;../../Native/EnemyActionFamilies.cs;../../Native/EnemyControlContract.cs;../../Native/EnemyControlActions.cs;../../Native/EnemyCombatActions.cs;../../Native/GlueActions.cs;../../Native/GlueFacts.cs;../../Native/EnemyBehaviorNative.cs;../../Native/EnemyBehaviorLedger.cs;../../Native/EnemyBehaviorActions.cs;../../Native/EnemyWaveModule.cs;../../Native/EnemyNodeEffectActions.cs;../../Native/EnemyNodeFacts.cs;../../Native/EnemyNodeRegistration.cs;../../Native/EnemyNodeValueReads.cs;../../Native/EnemySelector.cs;../../Native/EnemyAttackInstanceFacts.cs;../../Native/EnemyWaveFacts.cs;../../Native/Observation/*.cs" />
    <!-- The spawn requirement derivation is game-independent, and the dependency walk is the other half of it. -->
    <Compile Include="../../Spawn/EnemySpawnRequirements.cs" Link="EnemySpawnRequirements.cs" />
    <Compile Include="../../Spawn/EnemyContentDependencies.cs" Link="EnemyContentDependencies.cs" />
    <!-- The declaration half of every family the same registration carries, compiled the way the native assembly
         compiles it so the registered rows cannot drift from a second copy. -->
    <Compile Include="../../EnemyNode*Contract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../EnemyCombatContract.cs;../../GlueContract.cs;../../EnemyBehaviorContract.cs;../../EnemyWaveContract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../EnemySelectorContract.cs" Link="EnemySelectorContract.cs" />
    <Compile Include="../../AttackInstanceContract.cs" Link="AttackInstanceContract.cs" />
    <Compile Include="../../ModuleDefinition.cs" Link="ModuleDefinition.cs" />
    <!-- The game types the native set reads: the same doubles `NativePlugin` compiles, because the provider under
         test is the same provider. -->
    <Compile Include="../NativePlugin/*Doubles.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
