<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework><IsPackable>false</IsPackable>
    <!-- The SDK this suite is compiled against. The default is the in-tree Framework build output; an already
         built `ForgeRuntime.Framework.dll` may be passed instead, for the window in which the in-tree sources do
         not compile. -->
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt; to an already built ForgeRuntime.Framework.dll." />
  </Target>
  <ItemGroup>
    <!-- The package's whole native compile set, the same list `ForgeEnemy/Native/ForgeEnemy.Native.csproj` compiles:
         the application point under test is the real `EnemyModule`, reached the way the game reaches it, so a file
         that list leaves out is a member `EnemyModule` names and this project does not compile. The game types
         those sources read are the same doubles `NativePlugin` compiles, because the provider under test is the
         same provider. -->
    <Compile Include="../../Native/Plugin.cs;../../Native/EnemyPluginSession.cs;../../Native/EnemySpawnRequirementSource.cs;../../Native/EnemyHookInstall.cs;../../Native/Enemy*Hooks.cs;../../Native/EnemyModule*.cs;../../Native/EnemyActionFamilies.cs;../../EnemyRegistration.cs;../../EnemyControlContract.cs;../../Native/EnemyControlActions.cs;../../Native/EnemyCombatActions.cs;../../Native/GlueActions.cs;../../Native/GlueFacts.cs;../../Native/EnemyBehaviorNative.cs;../../Native/EnemyBehaviorLedger.cs;../../Native/EnemyBehaviorActions.cs;../../Native/EnemyWaveModule.cs;../../Native/EnemyNodeEffectActions.cs;../../Native/EnemyAbilityUsedFacts.cs;../../Native/EnemyVolumeActions.cs;../../Native/EnemyNodeFacts.cs;../../Native/EnemyNodeRegistration.cs;../../Native/EnemyNodeValueReads.cs;../../Native/EnemySelector.cs;../../Native/EnemyAttackInstanceFacts.cs;../../Native/EnemyWaveFacts.cs;../../Native/EnemyProfileActions.cs;../../Native/Observation/*.cs" />
    <!-- The reader under test, as it ships: the suite writes documents to a real directory and reads them back
         through the same discovery the installed plugin runs, so an accepted shape cannot be accepted only here. -->
    <Compile Include="../../Profile/*.cs" Link="Profile/%(Filename)%(Extension)" />
    <Compile Include="../../EnemyNode*Contract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../EnemyCombatContract.cs;../../GlueContract.cs;../../EnemyBehaviorContract.cs;../../EnemyWaveContract.cs;../../EnemyProfileContract.cs;../../EnemyStaggerContract.cs;../../EnemyAbilityInterruptedContract.cs;../../EnemyAbilityUsedContract.cs;../../EnemyVolumeContract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../EnemySelectorContract.cs" Link="EnemySelectorContract.cs" />
    <Compile Include="../../AttackInstanceContract.cs" Link="AttackInstanceContract.cs" />
    <Compile Include="../../ModuleDefinition.cs" Link="ModuleDefinition.cs" />
    <Compile Include="../../Spawn/EnemySpawnRequirements.cs" Link="EnemySpawnRequirements.cs" />
    <Compile Include="../NativePlugin/*Doubles.cs" Link="%(Filename)%(Extension)" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
</Project>
