<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <Target Name="RequireSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeFrameworkAssembly)')" Text="An explicitly compiled production SDK is required." />
  </Target>
  <ItemGroup>
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeFrameworkAssembly)" />
    <!-- The package's whole native compile set, the same list `ForgeEnemy/Native/ForgeEnemy.Native.csproj` compiles,
         because this suite's statement is the plugin entry point, the session lifetime and the install table: the
         module it registers is the entire provider, not one family of it. The rows a family declares travel with
         the family's own contract, so a file this project leaves out is a member `EnemyModule` names and does not
         compile. The game types those sources read are doubles here rather than interop references. -->
    <Compile Include="../../Native/Plugin.cs;../../Native/EnemyPluginSession.cs;../../Native/EnemySpawnRequirementSource.cs;../../Native/EnemyHookInstall.cs;../../Native/Enemy*Hooks.cs;../../Native/EnemyModule*.cs;../../Native/EnemyActionFamilies.cs;../../EnemyRegistration.cs;../../EnemyControlContract.cs;../../Native/EnemyControlActions.cs;../../Native/EnemyCombatActions.cs;../../Native/GlueActions.cs;../../Native/GlueFacts.cs;../../Native/EnemyBehaviorNative.cs;../../Native/EnemyBehaviorLedger.cs;../../Native/EnemyBehaviorActions.cs;../../Native/EnemyWaveModule.cs;../../Native/EnemyNodeEffectActions.cs;../../Native/EnemyAbilityUsedFacts.cs;../../Native/EnemyVolumeActions.cs;../../Native/EnemyNodeFacts.cs;../../Native/EnemyNodeRegistration.cs;../../Native/EnemyNodeValueReads.cs;../../Native/EnemySelector.cs;../../Native/EnemyAttackInstanceFacts.cs;../../Native/EnemyWaveFacts.cs;../../Native/EnemyProfileActions.cs;../../Native/Observation/*.cs" />
    <Compile Include="../../Spawn/EnemySpawnRequirements.cs" Link="EnemySpawnRequirements.cs" />
    <!-- The enemy profile reader is game-independent for the same reason the spawn derivation is: the plugin reads
         the documents through this one source, and this suite compiles it so a profile document cannot be accepted
         by one reader and refused by another. -->
    <Compile Include="../../Profile/*.cs" Link="Profile/%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeEnemy/EnemyNode*Contract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeEnemy/EnemyCombatContract.cs;../../../ForgeEnemy/GlueContract.cs;../../../ForgeEnemy/EnemyBehaviorContract.cs;../../../ForgeEnemy/EnemyWaveContract.cs;../../../ForgeEnemy/EnemyProfileContract.cs;../../../ForgeEnemy/EnemyStaggerContract.cs;../../../ForgeEnemy/EnemyAbilityInterruptedContract.cs;../../../ForgeEnemy/EnemyAbilityUsedContract.cs;../../../ForgeEnemy/EnemyVolumeContract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeEnemy/EnemySelectorContract.cs" Link="EnemySelectorContract.cs" />
    <Compile Include="../../../ForgeEnemy/AttackInstanceContract.cs" Link="AttackInstanceContract.cs" />
    <Compile Include="../../../ForgeEnemy/ModuleDefinition.cs" Link="ModuleDefinition.cs" />
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>
</Project>
