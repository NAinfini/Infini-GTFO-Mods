<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework><IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="RequireSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeFrameworkAssembly)')" Text="An explicitly built production SDK is required." />
  </Target>
  <ItemGroup>
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeFrameworkAssembly)" />
    <!-- The lifecycle fact family this suite owns, compiled as it ships, plus the native hook adapters that drive
         it and the session the hook case hands them: the domain lifetime, the entry point that owns it, and the
         two readers the session passes to the module. `EnemyModuleShim.cs` declares the members the family touches
         on the provider's own partial class — the entity table with its per-life death window and per-limb windows,
         the reference lookup, the kernel, the two fact gates and the registration — because the package's own
         `EnemyModule` core is edited by a dozen sibling slices at once and cannot be compiled here without also
         compiling their half-finished partials. Everything the facts themselves do is the production source,
         unchanged. The other hook families and the four action families are not compiled at all: they are not part
         of this suite's statement, and `NativePlugin` compiles them. -->
    <Compile Include="../../Native/EnemyModule.LifecycleFacts.cs" />
    <Compile Include="../../Native/EnemyLifecycleHooks.cs" />
    <Compile Include="../../Native/EnemyPluginSession.cs" />
    <Compile Include="../../Native/Plugin.cs" />
    <!-- The session hands these two readers to the module; the observations they perform are the readers' own
         business and are exercised by EntityObservation. -->
    <Compile Include="../../Native/Observation/EnemyEntityObserver.cs" />
    <Compile Include="../../Native/Observation/EnemyTypeReader.cs" />
    <!-- These cases never read spawn requirements; only Load attaches the runtime source. The real one
         needs the Unity/GameData/AssetShards references, which this suite avoids on purpose, so the
         harness supplies the one-member double. The real source is built with those references by
         NativePlugin and the derivation itself is exercised by SpawnRequirements. -->
    <Compile Include="../NativePlugin/GameDoubles.cs;../NativePlugin/LoaderDoubles.cs" />
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>
</Project>
