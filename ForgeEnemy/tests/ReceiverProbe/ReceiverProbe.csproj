<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework><IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="RequireExplicitSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ForgeFrameworkAssembly)' == '' or !Exists('$(ForgeFrameworkAssembly)')"
      Text="Pass -p:ForgeFrameworkAssembly=... with the explicitly selected, built SDK DLL. The probe records its hash." />
  </Target>
  <ItemGroup>
    <!-- Real compiled SDK, no shared SDK build output or in-progress source writes. -->
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeFrameworkAssembly)" />
    <!-- The package's whole native compile set, the same list `ForgeEnemy/Native/ForgeEnemy.Native.csproj` compiles:
         the receiver this probe dispatches to is reached through the entire provider, so a file that list leaves out
         is a member `EnemyModule` names and this project does not compile. The game types those sources read are the
         same doubles `NativePlugin` compiles, because the provider under probe is the same provider. -->
    <Compile Include="../../../ForgeEnemy/Native/Plugin.cs;../../../ForgeEnemy/Native/EnemyPluginSession.cs;../../../ForgeEnemy/Native/EnemySpawnRequirementSource.cs;../../../ForgeEnemy/Native/EnemyHookInstall.cs;../../../ForgeEnemy/Native/Enemy*Hooks.cs;../../../ForgeEnemy/Native/EnemyModule*.cs;../../../ForgeEnemy/Native/EnemyActionFamilies.cs;../../../ForgeEnemy/EnemyRegistration.cs;../../../ForgeEnemy/EnemyControlContract.cs;../../../ForgeEnemy/Native/EnemyControlActions.cs;../../../ForgeEnemy/Native/EnemyCombatActions.cs;../../../ForgeEnemy/Native/GlueActions.cs;../../../ForgeEnemy/Native/GlueFacts.cs;../../../ForgeEnemy/Native/EnemyBehaviorNative.cs;../../../ForgeEnemy/Native/EnemyBehaviorLedger.cs;../../../ForgeEnemy/Native/EnemyBehaviorActions.cs;../../../ForgeEnemy/Native/EnemyWaveModule.cs;../../../ForgeEnemy/Native/EnemyNodeEffectActions.cs;../../../ForgeEnemy/Native/EnemyNodeFacts.cs;../../../ForgeEnemy/Native/EnemyNodeRegistration.cs;../../../ForgeEnemy/Native/EnemyNodeValueReads.cs;../../../ForgeEnemy/Native/EnemySelector.cs;../../../ForgeEnemy/Native/EnemyAttackInstanceFacts.cs;../../../ForgeEnemy/Native/EnemyWaveFacts.cs;../../../ForgeEnemy/Native/Observation/*.cs" />
    <Compile Include="../../../ForgeEnemy/Spawn/EnemySpawnRequirements.cs" Link="EnemySpawnRequirements.cs" />
    <Compile Include="../../../ForgeEnemy/EnemyNode*Contract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeEnemy/EnemyCombatContract.cs;../../../ForgeEnemy/GlueContract.cs;../../../ForgeEnemy/EnemyBehaviorContract.cs;../../../ForgeEnemy/EnemyWaveContract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeEnemy/EnemySelectorContract.cs" Link="EnemySelectorContract.cs" />
    <Compile Include="../../../ForgeEnemy/AttackInstanceContract.cs" Link="AttackInstanceContract.cs" />
    <Compile Include="../../../ForgeEnemy/ModuleDefinition.cs" Link="ModuleDefinition.cs" />
    <Compile Include="../NativePlugin/*Doubles.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../Shared/*.cs" />
    <None Include="../../../ForgeEnemy/Native/EnemyModule.cs" Link="EnemyModule.source.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
