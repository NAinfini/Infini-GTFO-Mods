<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- `WaveDoubles.cs` deliberately declares the game types the observer is compiled against, so CS0436 fires on
         every mention of one. Which definition wins is decided by the `Compile` list below, not by reference order. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- The SDK this suite is compiled against. The default is the in-tree Framework build output; an already built
         `ForgeRuntime.Framework.dll` may be passed instead, for the window in which the in-tree sources do not
         compile. The observer is compiled into this assembly, so no built ForgeEnemy.dll is needed at all. -->
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
  </Target>
  <ItemGroup>
    <!-- The wave fact family under test: the observer and the contract rows it publishes through. The module
         adapter is not compiled here — it is the receiver's own partial, and this suite exercises the observation
         and the published frames without a session. -->
    <Compile Include="../../Native/EnemyWaveFacts.cs" />
    <Compile Include="../../EnemyWaveContract.cs" />
    <Compile Include="../../ModuleDefinition.cs" />
    <Compile Include="WaveDoubles.cs;WaveRecorder.cs;WaveFactsWorld.cs;WaveFactsTests.cs" />
    <Compile Include="../Shared/*.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
