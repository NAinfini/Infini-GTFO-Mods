<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework><IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="RequireExplicitSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeFrameworkAssembly)')" Text="Pass ForgeFrameworkAssembly from a successful ForgeRuntime.Framework build." />
  </Target>
  <ItemGroup>
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeFrameworkAssembly)" />
    <!-- The package's whole native compile set, the same list `ForgeEnemy/Native/ForgeEnemy.Native.csproj` compiles:
         the module whose observation this suite reads is the entire provider, so a file that list leaves out is a
         member `EnemyModule` names and this project does not compile. The game types those sources read are the same
         doubles `NativePlugin` compiles, because the provider under observation is the same provider. -->
    <Compile Include="../../../ForgeEnemy/Native/Plugin.cs;../../../ForgeEnemy/Native/EnemyPluginSession.cs;../../../ForgeEnemy/Native/EnemySpawnRequirementSource.cs;../../../ForgeEnemy/Native/EnemyHookInstall.cs;../../../ForgeEnemy/Native/Enemy*Hooks.cs;../../../ForgeEnemy/Native/EnemyModule*.cs;../../../ForgeEnemy/Native/EnemyActionFamilies.cs;../../../ForgeEnemy/EnemyRegistration.cs;../../../ForgeEnemy/EnemyControlContract.cs;../../../ForgeEnemy/Native/EnemyControlActions.cs;../../../ForgeEnemy/Native/EnemyCombatActions.cs;../../../ForgeEnemy/Native/GlueActions.cs;../../../ForgeEnemy/Native/GlueFacts.cs;../../../ForgeEnemy/Native/EnemyBehaviorNative.cs;../../../ForgeEnemy/Native/EnemyBehaviorLedger.cs;../../../ForgeEnemy/Native/EnemyBehaviorActions.cs;../../../ForgeEnemy/Native/EnemyWaveModule.cs;../../../ForgeEnemy/Native/EnemyNodeEffectActions.cs;../../../ForgeEnemy/Native/EnemyNodeFacts.cs;../../../ForgeEnemy/Native/EnemyNodeRegistration.cs;../../../ForgeEnemy/Native/EnemyNodeValueReads.cs;../../../ForgeEnemy/Native/EnemySelector.cs;../../../ForgeEnemy/Native/EnemyAttackInstanceFacts.cs;../../../ForgeEnemy/Native/EnemyWaveFacts.cs;../../../ForgeEnemy/Native/EnemyProfileActions.cs;../../../ForgeEnemy/Native/Observation/*.cs" />
    <Compile Include="../../../ForgeEnemy/Spawn/EnemySpawnRequirements.cs" Link="EnemySpawnRequirements.cs" />
    <Compile Include="../../../ForgeEnemy/EnemyNode*Contract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeEnemy/EnemyCombatContract.cs;../../../ForgeEnemy/GlueContract.cs;../../../ForgeEnemy/EnemyBehaviorContract.cs;../../../ForgeEnemy/EnemyWaveContract.cs;../../../ForgeEnemy/EnemyProfileContract.cs;../../../ForgeEnemy/EnemyStaggerContract.cs;../../../ForgeEnemy/EnemyAbilityInterruptedContract.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../../ForgeEnemy/EnemySelectorContract.cs" Link="EnemySelectorContract.cs" />
    <Compile Include="../../../ForgeEnemy/AttackInstanceContract.cs" Link="AttackInstanceContract.cs" />
    <Compile Include="../../../ForgeEnemy/ModuleDefinition.cs" Link="ModuleDefinition.cs" />
    <Compile Include="../NativePlugin/*Doubles.cs" Link="%(Filename)%(Extension)" />
    <None Include="../../../ForgeEnemy/Native/EnemyModule.cs" Link="EnemyModule.source.txt" CopyToOutputDirectory="Always" />
    <None Include="../../../ForgeEnemy/Native/Observation/EnemyEntityObserver.cs" Link="EnemyEntityObserver.source.txt" CopyToOutputDirectory="Always" />
    <None Include="../../../ForgeEnemy/Native/Observation/EnemyTypeReader.cs" Link="EnemyTypeReader.source.txt" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
