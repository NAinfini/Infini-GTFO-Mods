<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ForgeDevelopment.DevelopmentModuleTests</AssemblyName>
    <RootNamespace>ForgeDevelopment.Tests.DevelopmentModule</RootNamespace>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- The three production sources under test name no game type and no BepInEx type, so this project needs the
         SDK assembly and nothing else — the author gate is a parameter the plugin passes, not a mode read this
         module makes for itself. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
  </Target>
  <ItemGroup>
    <Compile Include="../../Native/DevelopmentModule.cs" />
    <Compile Include="../../Native/DiagnosticSessions.cs" />
    <Compile Include="../../Native/DiagnosticHandlers.cs" />
    <Compile Include="Program.cs;ModuleWorld.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
</Project>
