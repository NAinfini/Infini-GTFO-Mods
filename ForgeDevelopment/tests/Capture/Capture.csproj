<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AssemblyName>DevelopmentCapture</AssemblyName>
    <RootNamespace>ForgeDevelopment.Tests.Capture</RootNamespace>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
    <NativeDir Condition="'$(NativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Native</NativeDir>
    <NoWarn>CS8604</NoWarn>
  </PropertyGroup>
  <!-- The tracer's own parser and the snapshot model are compiled in rather than referenced: the point of this suite is
       that it can read a profile and a capture with no game assembly and no plugin build behind it. -->
  <ItemGroup>
    <Compile Include="$(NativeDir)\RecTracer.cs" />
    <Compile Include="$(NativeDir)\CaptureSnapshotModel.cs" />
    <Compile Include="$(NativeDir)\CaptureSections.cs" />
    <Compile Include="$(NativeDir)\CaptureChangeDetector.cs" />
    <Compile Include="$(NativeDir)\CaptureStateWriter.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil" HintPath="$(GTFOBepInExPath)/core/Mono.Cecil.dll" />
  </ItemGroup>
</Project>
