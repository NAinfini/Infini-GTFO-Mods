<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable><AssemblyName>Recorder</AssemblyName><RootNamespace>ForgeDevelopment.Recorder</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The recorder core is compiled here from its own sources: the session, the reader and the tracer's two decision
         files carry no Unity, BepInEx or IL2CPP reference, which is what makes them testable in a plain process. -->
    <Compile Include="../../Native/RecReflect.cs" Link="Production/RecReflect.cs" />
    <Compile Include="../../Native/RecSession.cs" Link="Production/RecSession.cs" />
    <Compile Include="../../Native/RecTracer.cs" Link="Production/RecTracer.cs" />
    <Compile Include="../../Native/RecTracerRuntime.cs" Link="Production/RecTracerRuntime.cs" />
    <!-- The tracer's generated patch notifies the experiments module's wait channel on its way out, so that file is
         compiled here as well: it carries the whole mechanism and depends on nothing but the standard library. -->
    <Compile Include="../../Native/ExperimentTrace.cs" Link="Production/ExperimentTrace.cs" />
    <Compile Include="../../Native/RecTracerPatches.cs" Link="Production/RecTracerPatches.cs" />
  </ItemGroup>
</Project>
