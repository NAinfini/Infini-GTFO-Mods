[
  {
    "id": "runtime-overhead-window",
    "title": "采集开销窗口：60 秒内每 5 秒记录一次帧数与已写记录数",
    "points": ["development.collector-overhead"],
    "host": "any",
    "target": "static:ForgeDevelopment.Native.RecSession",
    "steps": [
      { "call": "get_PendingRecords" },
      {
        "repeat": {
          "times": 12,
          "steps": [
            { "read": ["active", "sessionId", "pendingRecords", "bytesWritten", "dropped"], "target": "static:ForgeDevelopment.Native.RecSession" },
            { "wait": { "seconds": 5.0 } }
          ]
        }
      },
      { "screenshot": "overhead-window" }
    ]
  },
  {
    "id": "runtime-session-state",
    "title": "会话状态与丢弃计数（退出前读一次，和收尾记录对照）",
    "points": ["runtime.log-managed-thread"],
    "host": "any",
    "target": "static:ForgeDevelopment.Native.RecSession",
    "steps": [
      {
        "read": ["active", "sessionId", "directory", "bytesWritten", "dropped", "budgetReached", "pendingRecords"],
        "target": "static:ForgeDevelopment.Native.RecSession"
      },
      { "screenshot": "session-state" }
    ]
  }
]
