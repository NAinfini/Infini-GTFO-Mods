[
  {
    "id": "hud-shield-write",
    "title": "写入原版护盾条 50 / 上限 / 超上限，下一帧与 1 秒后读回",
    "points": ["hud.shield-bar-usable", "hud.shield-normalization"],
    "host": "any",
    "target": "localPlayerStatus",
    "before": {
      "snapshot": ["m_shieldUIParent.activeInHierarchy", "m_shieldValueRef", "m_lastShieldVal", "m_shield1.rectTransform.sizeDelta"],
      "screenshot": true
    },
    "steps": [
      { "call": "UpdateShield", "args": [50.0] },
      { "wait": { "frames": 1 } },
      { "read": ["m_lastShieldVal", "m_shield1.rectTransform.sizeDelta", "m_shield2.rectTransform.sizeDelta", "m_shield1.color"], "screenshot": true },
      { "wait": { "seconds": 1.0 } },
      { "read": ["m_lastShieldVal", "m_shield1.rectTransform.sizeDelta", "m_shield1.color"], "screenshot": true },
      { "call": "UpdateShield", "args": [100.0] },
      { "wait": { "frames": 1 } },
      { "read": ["m_lastShieldVal", "m_shield1.rectTransform.sizeDelta"], "screenshot": true },
      { "wait": { "seconds": 1.0 } },
      { "read": ["m_lastShieldVal", "m_shield1.rectTransform.sizeDelta"] },
      { "call": "UpdateShield", "args": [1000.0] },
      { "wait": { "frames": 1 } },
      { "read": ["m_lastShieldVal", "m_shield1.rectTransform.sizeDelta"], "screenshot": true },
      { "wait": { "seconds": 1.0 } },
      { "read": ["m_lastShieldVal", "m_shield1.rectTransform.sizeDelta"] }
    ],
    "cleanup": [
      { "call": "UpdateShield", "args": [0.0] },
      { "wait": { "frames": 1 } },
      { "read": ["m_lastShieldVal"], "screenshot": true }
    ]
  },
  {
    "id": "hud-shield-overlap",
    "title": "感染条与护盾条同时非零时的几何对照",
    "points": ["hud.shield-overlap"],
    "host": "any",
    "target": "localPlayerStatus",
    "steps": [
      { "call": "UpdateInfection", "args": [50.0, 0.5] },
      { "call": "UpdateShield", "args": [50.0] },
      { "wait": { "frames": 1 } },
      { "read": ["m_infection1.rectTransform.sizeDelta", "m_shield1.rectTransform.sizeDelta", "m_shield1.rectTransform.anchoredPosition", "m_infection1.rectTransform.anchoredPosition"], "screenshot": true },
      { "wait": { "seconds": 1.0 } },
      { "screenshot": "overlap-settled" }
    ],
    "cleanup": [
      { "call": "UpdateShield", "args": [0.0] },
      { "call": "UpdateInfection", "args": [0.0, 0.0] }
    ]
  },
  {
    "id": "hud-shield-hide-states",
    "title": "观察护盾条的显示/隐藏时机（菜单、倒地、终端无法脚本化，记录当前状态）",
    "points": ["hud.shield-hidden-states"],
    "host": "any",
    "target": "guiManager",
    "steps": [
      {
        "read": [
          "m_playerLayer.m_playerStatus.m_shieldUIParent.activeInHierarchy",
          "m_playerLayer.m_playerStatus.m_shieldValueRef",
          "m_playerLayer.gameObject.activeInHierarchy",
          "m_playerLayer.m_playerStatus.m_shieldText.text"
        ]
      },
      { "screenshot": "shield-visibility" }
    ]
  },
  {
    "id": "hud-tmp-clone",
    "title": "克隆原生 TMP 显示一行文字（B 方案），并销毁克隆体",
    "points": ["hud.custom-subtext-reflow"],
    "host": "any",
    "target": "guiManager",
    "steps": [
      {
        "clone": "m_playerLayer.Inventory.m_headerTxt",
        "parent": "m_playerLayer.Inventory.m_headerTxt.rectTransform",
        "text": "<color=#FFD24A>experiment: cloned TMP</color>"
      },
      { "wait": { "frames": 1 } },
      { "read": ["text", "rectTransform.anchoredPosition", "fontSize", "color"], "target": "result", "screenshot": true },
      { "wait": { "seconds": 1.0 } },
      { "screenshot": "tmp-clone-settled" }
    ],
    "cleanup": [
      { "call": "Destroy", "result": true, "target": "static:UnityEngine.Object" },
      { "screenshot": "tmp-clone-cleanup" }
    ]
  },
  {
    "id": "hud-objective-rows-read",
    "title": "目标面板上每行的 TMP 文字与位置（克隆 TMP 前的坐标基准）",
    "points": ["hud.custom-subtext-reflow", "generator.placements-vs-count"],
    "host": "any",
    "target": "guiManager",
    "steps": [
      {
        "read": [
          "m_playerLayer.m_wardenObjective.m_header.text",
          "m_playerLayer.m_wardenObjective.m_header.rectTransform.anchoredPosition",
          "m_playerLayer.m_wardenObjective.m_items.text",
          "m_playerLayer.m_wardenObjective.m_items.rectTransform.anchoredPosition",
          "m_playerLayer.Inventory.m_headerTxt.text",
          "m_playerLayer.Inventory.m_headerTxt.rectTransform.anchoredPosition"
        ]
      },
      { "screenshot": "objective-rows" }
    ]
  }
]
