[
  {
    "id": "damage-rewrite-arm-50",
    "title": "伤害生效前改写：把本机玩家受到的伤害乘 0.5，等下一次受伤后读回血量",
    "points": ["player.health-pool-client-view"],
    "host": "any",
    "target": "localPlayer",
    "before": {
      "snapshot": ["Damage.Health", "Damage.HealthMax", "Damage.GetHealthRel", "Damage.Infection"],
      "screenshot": true
    },
    "steps": [
      { "call": "ArmDamage", "args": [0.5], "target": "static:ForgeDevelopment.Native.ExperimentHelper" },
      { "read": ["Damage.Health", "Damage.HealthMax"], "target": "localPlayer" },
      { "wait": { "path": "Damage.Health", "changed": true, "timeoutFrames": 3600 } },
      { "read": ["Damage.Health", "Damage.HealthMax", "Damage.GetHealthRel"], "target": "localPlayer", "screenshot": true }
    ],
    "cleanup": [
      { "call": "DisarmDamage", "target": "static:ForgeDevelopment.Native.ExperimentHelper" },
      { "read": ["Damage.Health"], "target": "localPlayer", "screenshot": true }
    ]
  },
  {
    "id": "damage-rewrite-arm-zero",
