[
  {
    "id": "mark-place-custom",
    "title": "PlaceCustomMarker 挂在准星所指的敌人身上",
    "points": ["mark.marker-placement-diff", "mark.enemy-icon-render"],
    "host": "any",
    "target": "lookedAtEnemy",
    "steps": [
      { "read": ["m_tagMarker", "IsTagged", "EnemyTaggedTimer"] },
      { "call": "get_MainModelGO" },
      {
        "call": "PlaceOnResult",
        "named": { "option": "EnemyTitleDistance", "title": "experiment: custom marker", "destroyDelay": 0.0 },
        "target": "static:ForgeDevelopment.Native.ExperimentHelper"
      }
    ],
    "cleanup": [
      { "screenshot": "place-custom-marker" }
    ]
  },
  {
    "id": "mark-place-on-looked-at-enemy",
    "title": "准星敌人 + 自定义标记：跟随、图标、2 秒后仍在",
    "points": ["mark.marker-placement-diff", "mark.two-markers-overlap"],
    "host": "any",
    "target": "lookedAtEnemy",
    "steps": [
      { "call": "get_MainModelGO" },
      {
        "call": "PlaceCustomMarker",
        "named": { "type": "EnemyTitleDistance", "name": "experiment: enemy marker", "destroyDelay": 0.0 },
        "target": "navMarkerLayer"
      },
      { "wait": { "frames": 1 } },
      { "read": ["m_trackingObj.name", "m_title.text", "m_distance.text", "m_title.color"], "target": "result" },
      { "screenshot": "enemy-marker" },
      { "wait": { "seconds": 2.0 } },
      { "read": ["m_trackingObj.name", "m_title.text"], "target": "result", "screenshot": true }
    ]
  },
  {
    "id": "mark-prepare",
    "title": "PrepareMarker 底层放置口",
    "points": ["mark.marker-placement-diff"],
    "host": "any",
    "target": "lookedAtEnemy",
    "steps": [
      { "call": "get_MainModelGO" },
      { "call": "PrepareMarker", "result": true, "target": "navMarkerLayer" },
      { "wait": { "frames": 1 } },
      { "read": ["m_trackingObj.name", "m_trackingTrans.name"], "target": "result" },
      { "screenshot": "prepare-marker" }
    ],
    "cleanup": [
      { "call": "RemoveLastMarker", "target": "static:ForgeDevelopment.Native.ExperimentHelper" }
    ]
  },
  {
    "id": "mark-selection-color-null",
    "title": "PlaceSelectionMarker 传 null 颜色",
    "points": ["mark.selection-null-color"],
    "host": "any",
    "target": "lookedAtEnemy",
    "steps": [
      { "call": "get_MainModelGO" },
      {
        "call": "SelectOnResult",
        "named": { "plain": true, "red": 0.0, "green": 0.0, "blue": 0.0, "alpha": 0.0 },
        "target": "static:ForgeDevelopment.Native.ExperimentHelper"
      },
      { "wait": { "frames": 1 } },
      { "read": ["m_title.text", "m_distance.text", "m_trackingObj.name"], "target": "result" },
      { "screenshot": "selection-marker-null" }
    ],
    "cleanup": [
      { "call": "RemoveLastMarker", "target": "static:ForgeDevelopment.Native.ExperimentHelper" }
    ]
  },
  {
    "id": "mark-selection-color-gold",
    "title": "PlaceSelectionMarker 传金色，改样式后读回颜色",
    "points": ["mark.selection-null-color", "mark.setcolor-scope", "mark.setcolor-order"],
    "host": "any",
    "target": "lookedAtEnemy",
    "steps": [
      { "call": "get_MainModelGO" },
      {
        "call": "SelectOnResult",
        "named": { "plain": false, "red": 1.0, "green": 0.82, "blue": 0.29, "alpha": 1.0 },
        "target": "static:ForgeDevelopment.Native.ExperimentHelper"
      },
      { "wait": { "frames": 1 } },
      { "read": ["m_title.color", "m_title.text", "m_playerName.color", "m_distance.color", "m_signInfo.color"], "target": "result" },
      { "screenshot": "selection-marker-gold" },
      { "call": "SetColor", "args": [[1.0, 0.2, 0.2, 1.0]], "target": "result" },
      { "wait": { "frames": 1 } },
      { "read": ["m_title.color", "m_playerName.color", "m_distance.color", "m_signInfo.color"], "target": "result", "screenshot": true },
      { "call": "SetStyle", "args": ["PlayerPingEnemy"], "target": "result" },
      { "wait": { "frames": 1 } },
      { "read": ["m_title.color", "m_playerName.color", "m_distance.color", "m_signInfo.color"], "target": "result", "screenshot": true }
    ],
    "cleanup": [
      { "call": "RemoveLastMarker", "target": "static:ForgeDevelopment.Native.ExperimentHelper" }
    ]
  },
  {
    "id": "mark-tag-marker-read",
    "title": "读私有字段 m_tagMarker（生物追踪器红 tag）",
    "points": ["mark.tagmarker-readable", "mark.rescan-replay"],
    "host": "any",
    "target": "nearestEnemy",
    "steps": [
      { "read": ["m_tagMarker", "IsTagged", "WasTagged", "EnemyTaggedTimer"] },
      { "wait": { "path": "m_tagMarker", "timeoutFrames": 600 } },
      { "read": ["m_tagMarker.m_title.color", "m_tagMarker.m_playerName.text", "m_tagMarker.m_distance.text", "m_tagMarker.m_trackingObj.name"], "screenshot": true }
    ]
  },
  {
    "id": "mark-tag-marker-setcolor",
    "title": "对原版 tag 的 m_tagMarker 调 SetColor，检查是否被重扫冲掉",
    "points": ["mark.setcolor-scope", "mark.rescan-replay"],
    "host": "any",
    "target": "nearestEnemy",
    "steps": [
      { "read": ["m_tagMarker", "IsTagged"] },
      { "wait": { "path": "m_tagMarker", "timeoutFrames": 600 } },
      { "call": "SetColor", "args": [[1.0, 0.82, 0.29, 1.0]], "target": "result" },
      { "wait": { "frames": 1 } },
      { "read": ["m_title.color", "m_playerName.color", "m_distance.color"], "target": "result" },
      { "screenshot": "tag-marker-gold" },
      { "wait": { "seconds": 3.0 } },
      { "read": ["m_title.color"], "target": "result", "screenshot": true }
    ]
  },
  {
    "id": "mark-destroy-delay-zero",
    "title": "PlaceCustomMarker 的 destroyDelay=0 是永久还是立即销毁",
    "points": ["mark.destroy-delay-zero"],
    "host": "any",
    "target": "nearestEnemy",
    "steps": [
      { "call": "get_MainModelGO" },
      { "call": "PlaceCustomMarker", "named": { "type": "EnemyTitleDistance", "name": "experiment: zero delay", "destroyDelay": 0.0 }, "target": "navMarkerLayer" },
      { "wait": { "frames": 1 } },
      { "read": ["m_trackingObj.name"], "target": "result", "screenshot": true },
      { "wait": { "seconds": 3.0 } },
      { "read": ["m_trackingObj.name"], "target": "result", "screenshot": true }
    ],
    "cleanup": [
      { "call": "RemoveAllExperimentMarkers", "target": "static:ForgeDevelopment.Native.ExperimentHelper" }
    ]
  },
  {
    "id": "mark-clean-slate",
    "title": "清除本轮实验创建的所有标记与克隆体",
    "points": ["mark.two-markers-overlap"],
    "host": "any",
    "target": "lookedAtEnemy",
    "steps": [
      { "read": ["m_tagMarker", "IsTagged"] },
      { "call": "RemoveAllExperimentMarkers", "target": "static:ForgeDevelopment.Native.ExperimentHelper" },
      { "screenshot": "marker-cleanup" }
    ]
  }
]
