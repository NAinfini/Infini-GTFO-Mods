<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- net6.0 is what the BepInEx plugin projects target, so the tool compiles against the same surface; the
         end-of-support notice is about the SDK's servicing policy, not about this offline build. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AssemblyName>export-runtime-manifest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- One RuntimeModule identity: every module declaration below compiles against this same Framework project,
         so the tool and the packages share one SDK assembly instead of a second copy beside it. -->
    <ProjectReference Include="../../ForgeRuntime/Framework/ForgeRuntime.Framework.csproj" />
    <!-- The provider declarations are compiled from their production sources, the way the runtime test projects
         wire modules in: a project reference to a package assembly would drag that package's whole build state
         (and, for ForgeEnemy, the game-bound native assembly) into a release-time tool. ForgeMap, ForgeWeapon and
         ForgeTrigger keep every game-independent source file at their package root, so each declaration set is
         that whole set; naming individual files would silently drop a declaration the next refactor adds. -->
    <Compile Include="../../ForgeMap/*.cs" Link="Modules/ForgeMap/%(Filename)%(Extension)" />
    <!-- A Map feature keeps its game-independent half in its own `Features/<feature>/` directory beside its
         registration, so the declaration set is the root glob above plus every feature directory. Without this the
         tool would compile a `ModuleRegistration` that names registrations it cannot see. -->
    <Compile Include="../../ForgeMap/Features/**/*.cs" Link="Modules/ForgeMap/Features/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../ForgeWeapon/*.cs" Link="Modules/ForgeWeapon/%(Filename)%(Extension)" />
    <Compile Include="../../ForgeTrigger/*.cs" Link="Modules/ForgeTrigger/%(Filename)%(Extension)" />
    <Compile Include="../../ForgeTrigger/Pure/*.cs" Link="Modules/Pure/%(Filename)%(Extension)" />
    <!-- The trigger module's own declaration composes the targeting half — the selector and condition rows it
         registers — so those sources belong to the same declaration set. -->
    <Compile Include="../../ForgeTrigger/Targeting/*.cs" Link="Modules/Targeting/%(Filename)%(Extension)" />
    <!-- ForgeEnemy is the one package whose provider declaration lives beside its game-bound module rather than in a
         contract of its own. This tool registers the declaration half only — the rows every contract at the package
         root declares, plus the control family's own declaration file — and never the module: `EnemyDeclaration`
         composes them and replaces every body with a stand-in that refuses to run, the same way the packages above
         register their contracts' rows against a game that is not here. The game-bound sources (`EnemyModule*.cs`,
         the selector's native evaluator, the observers) are deliberately absent: compiling them would drag the whole
         game surface, and a second implementation of their rows into a release-time tool. -->
    <Compile Include="../../ForgeEnemy/*.cs" Link="ForgeEnemy/%(Filename)%(Extension)" />
    <!-- The control family's rows, binding support and shapes are declared in this one file. It is a partial of the
         module and reads the three handler ids and port fields from it, so `EnemyDeclaration` carries the
         declaration-only half of that type; nothing in this process calls the native bodies. -->

  </ItemGroup>
</Project>
