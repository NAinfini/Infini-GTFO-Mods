<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- `WeaponOverrideApplier.Construct<T>` reaches a native GameData constructor through
         `IL2CPP.il2cpp_runtime_invoke`, exactly as the generated interop members do, so this project needs the same
         switch the game assemblies are built with. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- `GameDoubles.cs`/`LoaderDoubles.cs` deliberately declare stand-ins for game and loader types that the
         production native sources are compiled against, and the interop assemblies are referenced for their other
         members, so CS0436 fires on every mention of a shadowed type. Which definition wins is decided by the
         `Compile` list above, not by reference order, so the notice carries no information here. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- The host ForgeRuntime build the native postfixes are compiled against; override for another artifacts path. -->
    <ForgeRuntimeAssembly Condition="'$(ForgeRuntimeAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime/release/ForgeRuntime.dll</ForgeRuntimeAssembly>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeAssembly)')"
      Text="Build ForgeRuntime with --artifacts-path ForgeWeapon/.artifacts/dotnet first, or pass -p:ForgeRuntimeAssembly=&lt;path&gt;." />
    <Error Condition="!Exists('$(GTFOBepInExPath)/core/BepInEx.Core.dll') or !Exists('$(GTFOBepInExPath)/interop/Modules-ASM.dll')"
      Text="Set GTFOBepInExPath or GTFO_BEPINEX_PATH to existing local compilation references." />
  </Target>
  <ItemGroup>
    <!-- Production native sources compiled against loader/game doubles; no GTFO assembly is loaded. -->
    <Compile Include="../../Native/Plugin.cs;../../Native/WeaponNativeSession.cs;../../Native/WeaponNativeHooks.cs;../../Native/EquipmentNativeAdapter.cs;../../Native/WeaponCombatObserver.cs;../../Native/CombatFactsObserver.cs;../../Native/WeaponProjectileActions.cs;../../Native/UnityValueBridge.cs;../../Native/GearPartTransformData.cs;../../Native/GearPartTransformApplier.cs;../../Native/LoadoutPolicyData.cs;../../Native/LoadoutPolicyWiring.cs;../../Native/GearLoadoutFilter.cs;../../Native/GearLoadoutSession.cs;../../Native/Il2CppGearPool.cs;../../Native/WeaponPlacementHooks.cs" />
    <!-- The families the package's own hook list names: every hook class a list carries has to be compiled here or
         the installation this suite pins cannot be built. The device, holder, melee, attack-instance and
         reload/inventory sources come with the observers their hooks reach. -->
    <Compile Include="../../Native/AttackInstanceHooks.cs;../../Native/AttackInstanceModule.cs;../../Native/FactRouter.cs;../../Native/WeaponDeployableFacts.cs;../../Native/WeaponHolderChannel.cs;../../Native/WeaponHolderModule.cs;../../Native/WeaponMeleeHitFacts.cs;../../Native/WeaponMeleeRemoteFacts.cs;../../Native/WeaponMeleeRemoteLedger.cs;../../Native/ReloadFacts.cs;../../Native/InventoryFacts.cs;../../Native/ReloadInventoryHooks.cs;../../Native/InventoryQuerySource.cs" />
    <!-- The bodies the one registration carries: the ammunition pair, the instance-override family and the
         inventory pair. `WeaponNativeSession` constructs all of them, so a file missing here is the session
         failing to build rather than a row the registry did not receive. -->
    <Compile Include="../../Native/WeaponSupplyActions.cs;../../Native/WeaponSupplyItems.cs;../../Native/InventoryActions.cs;../../Native/WeaponOverrideApplier.cs;../../Native/WeaponActionAdapter.cs" />
    <!-- The override rows' decisions are game-independent and live beside the contract; the applier reads them. -->
    <Compile Include="../../Actions/WeaponActionRuntime.cs" />
    <Compile Include="../../WeaponStateTriggerContract.cs;../../CombatPrimitiveContract.cs;../../WeaponHolderChannelContract.cs;../../WeaponHolderActionsContract.cs" />
    <Compile Include="NativeAdapterTests.cs;GearPartTransformTests.cs;LoadoutRuntimeTests.cs;LoadoutDoubles.cs;TestWorld.cs;GameDoubles.cs;HookTargetDoubles.cs;LoaderDoubles.cs;TestPlanLoading.cs" />
    <!-- The loadout fixture builds a real policy file and reads it with the production loader, so the projection and
         the pool narrowing are exercised against an accepted snapshot rather than a hand-built one. -->
    <Compile Include="../LoadoutPolicy/PolicyFixture.cs" />
    <!-- The domain assembly is a project reference normally; -p:ForgeWeaponAssembly=&lt;dll&gt; substitutes an
         already built one, for the window in which the Framework sources in the tree do not compile. That also
         removes the transitive Framework reference, so -p:ForgeRuntimeFrameworkAssembly=&lt;dll&gt; restores it. -->
    <ProjectReference Include="../../ForgeWeapon.csproj" Condition="'$(ForgeWeaponAssembly)' == ''" />
    <Reference Include="ForgeWeapon" HintPath="$(ForgeWeaponAssembly)" Condition="'$(ForgeWeaponAssembly)' != ''" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" Condition="'$(ForgeRuntimeFrameworkAssembly)' != ''" />
    <Reference Include="ForgeRuntime" HintPath="$(ForgeRuntimeAssembly)" />
    <Reference Include="BepInEx.Core" HintPath="$(GTFOBepInExPath)/core/BepInEx.Core.dll" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(GTFOBepInExPath)/core/BepInEx.Unity.IL2CPP.dll" />
    <Reference Include="0Harmony" HintPath="$(GTFOBepInExPath)/core/0Harmony.dll" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GTFOBepInExPath)/core/Il2CppInterop.Runtime.dll" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GTFOBepInExPath)/interop/Il2Cppmscorlib.dll" />
    <!-- UnityEngine.CoreModule is deliberately absent: this project supplies its own UnityEngine doubles, and the
         interop assembly would take over every name inside its own namespace — the doubles' `Transform` included —
         which is what the interop game types below are doubled for instead. The launch body is the one native file
         that cannot be compiled under these doubles: it reaches the game's own prefab spawn, whose signature names
         a `MonoBehaviour`. That body is checked by the Native project's own build against the real interop, which
         is where every game signature in this package is pinned. -->
    <Reference Include="Modules-ASM" HintPath="$(GTFOBepInExPath)/interop/Modules-ASM.dll" />
    <Reference Include="SNet_ASM" HintPath="$(GTFOBepInExPath)/interop/SNet_ASM.dll" />
    <Reference Include="Utils-ASM" HintPath="$(GTFOBepInExPath)/interop/Utils-ASM.dll" />
    <Reference Include="GameData-ASM" HintPath="$(GTFOBepInExPath)/interop/GameData-ASM.dll" />
    <Reference Include="GlobalFramework-ASM" HintPath="$(GTFOBepInExPath)/interop/GlobalFramework-ASM.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- The suite drives process-wide static state (the doubles' backpack table, the host plugin's mode and
         runtime, the Harmony patch counters) and one single-instance native session, so cases must not interleave:
         the runner setting is what the test host reads, and the assembly attribute alone was not honoured. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>