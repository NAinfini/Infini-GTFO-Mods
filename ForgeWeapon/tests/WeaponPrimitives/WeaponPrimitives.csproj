<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- The SDK this package is compiled against. The default is the in-tree Framework build output; an already
         built `ForgeRuntime.Framework.dll` may be passed instead, for the window in which the in-tree sources do
         not compile. -->
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
    <Error Condition="!Exists('$(GTFOBepInExPath)/interop/Modules-ASM.dll')"
      Text="Set GTFOBepInExPath or GTFO_BEPINEX_PATH to existing local compilation references." />
  </Target>
  <ItemGroup>
    <!-- The three row sets this batch adds, plus every contract `ModuleDefinition.Create` names, because the
         registration composes them: a row this project could not build would be a row the registration failed to
         declare rather than a row the test chose not to look at. Nothing here touches a game type, so the whole
         registration and every evaluator body are exercised without the game. -->
    <Compile Include="../../WeaponStateTriggerContract.cs" />
    <Compile Include="../../CombatPrimitiveContract.cs" />
    <Compile Include="../../WeaponSupplyContract.cs" />
    <Compile Include="../../WeaponOverrideContract.cs" />
    <Compile Include="../../WeaponDeployableFactsContract.cs" />
    <Compile Include="../../WeaponMeleeHitContract.cs" />
    <Compile Include="../../AttackInstanceContract.cs" />
    <Compile Include="../../InventoryActionContract.cs" />
    <Compile Include="../../InventoryQueryContract.cs" />
    <Compile Include="../../InventoryQueryReads.cs" />
    <Compile Include="../../ReloadInventoryContract.cs" />
    <Compile Include="../../WeaponHolderChannelContract.cs" />
    <Compile Include="../../WeaponHolderActionsContract.cs" />
    <Compile Include="../../ModuleDefinition.cs" />
    <Compile Include="WeaponPrimitiveContractTests.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
