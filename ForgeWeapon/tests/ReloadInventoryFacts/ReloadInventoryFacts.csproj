<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The observers and the contract are game-independent: they are written in the native-reads interface, an
         item key and a slot name, so this project compiles no GTFO type into the source under test at all. What it
         does reference is the interop metadata, so that a native member this build does not have cannot be added
         to the native half without this project failing. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- The SDK this package is compiled against. The default is the in-tree Framework build output; an already
         built `ForgeRuntime.Framework.dll` may be passed instead, for the window in which the in-tree sources do
         not compile. The observers are compiled into this assembly so no built ForgeWeapon.dll is needed. -->
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
    <Error Condition="!Exists('$(GTFOBepInExPath)/interop/Modules-ASM.dll')"
      Text="Set GTFOBepInExPath or GTFO_BEPINEX_PATH to existing local compilation references." />
  </Target>
  <ItemGroup>
    <!-- The two production sources under test plus the contract they publish under; no GTFO assembly is loaded and
         no game type is compiled in, so these cases prove the observers' own decisions. -->
    <Compile Include="../../Native/ReloadFacts.cs" />
    <Compile Include="../../Native/InventoryFacts.cs" />
    <Compile Include="../../ReloadInventoryContract.cs" />
    <!-- The other three contracts the module registers rows from: it names them, so they compile with it. -->
    <Compile Include="../../AttackInstanceContract.cs" />
    <Compile Include="../../WeaponDeployableFactsContract.cs" />
    <Compile Include="../../WeaponMeleeHitContract.cs" />
    <Compile Include="../../WeaponPlacementContract.cs" />
    <!-- `ModuleDefinition.Create` composes the action families' rows too, so their contracts compile with it. -->
    <Compile Include="../../WeaponSupplyContract.cs" />
    <Compile Include="../../WeaponOverrideContract.cs" />
    <Compile Include="../../InventoryActionContract.cs" />
    <Compile Include="../../InventoryQueryContract.cs" />
    <Compile Include="../../InventoryQueryReads.cs" />
    <Compile Include="../../ModuleDefinition.cs" />
    <Compile Include="FactsWorld.cs;ReloadFactsTests.cs;InventoryFactsTests.cs;InventoryQueryFactsTests.cs;ReloadInventoryContractTests.cs;Fixtures.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GTFOBepInExPath)/interop/Il2Cppmscorlib.dll" />
    <!-- Referenced for its metadata only: `Utils-ASM` and `SNet_ASM` are what `Modules-ASM`'s own base types live
         in, so the reference graph closes. Nothing here loads or calls into either assembly. -->
    <Reference Include="Modules-ASM" HintPath="$(GTFOBepInExPath)/interop/Modules-ASM.dll" />
    <Reference Include="Utils-ASM" HintPath="$(GTFOBepInExPath)/interop/Utils-ASM.dll" />
    <Reference Include="SNet_ASM" HintPath="$(GTFOBepInExPath)/interop/SNet_ASM.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
