<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The contract files under test compile `ModuleDefinition.cs` beside them, which is the same production
         module the native half registers; nothing here names a game type, so no game double is compiled in. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- The SDK this package is compiled against. The default is the in-tree Framework build output; an already
         built `ForgeRuntime.Framework.dll` may be passed instead, for the window in which the in-tree sources do
         not compile. -->
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
  </Target>
  <ItemGroup>
    <!-- The game-independent half: the placement contract and the module it is registered through. -->
    <Compile Include="../../WeaponPlacementContract.cs" />
    <!-- The rows the module registers beside the placement pair: the module names their contracts, so they are
         compiled with it rather than reached through a built assembly. -->
    <Compile Include="../../AttackInstanceContract.cs" />
    <Compile Include="../../WeaponDeployableFactsContract.cs" />
    <Compile Include="../../WeaponMeleeHitContract.cs" />
    <!-- The three action families the module's declaration names: its capability and binding lists are built from
         these contracts whether or not a body is supplied for them, so the module cannot be compiled without
         them. None of the three names a game type. -->
    <Compile Include="../../WeaponSupplyContract.cs" />
    <Compile Include="../../WeaponOverrideContract.cs" />
    <Compile Include="../../InventoryActionContract.cs" />
    <Compile Include="../../ModuleDefinition.cs" />
    <Compile Include="PlacementWorld.cs;PlacementRowTests.cs;PlacementFactTests.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
