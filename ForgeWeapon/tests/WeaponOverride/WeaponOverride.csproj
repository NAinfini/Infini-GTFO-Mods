<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The applier publishes a native constructor through Il2CppInterop's own `void**` overload, exactly as the
         generated interop members do, so this project needs the same switch the game assemblies are built with. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The production native source is compiled against doubles that declare the game's own types, so CS0436
         fires on every mention of a shadowed type. Which definition wins is decided by the `Compile` list below,
         not by reference order, so the notice carries no information here. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.build/override/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
    <Error Condition="!Exists('$(GTFOBepInExPath)/interop/Modules-ASM.dll')"
      Text="Set GTFOBepInExPath or GTFO_BEPINEX_PATH to existing local compilation references." />
  </Target>
  <ItemGroup>
    <!-- The production sources this slice owns on the game-independent side, plus the native applier, which is
         compiled against the double of every game type it names. `ModuleDefinition.cs` is here because the
         contract reads the provider's own id and write permission from it: the binding ids and the permission are
         asserted to be the same ones, not copies of them. -->
    <Compile Include="../../WeaponOverrides.cs;../../WeaponOverrideContract.cs;../../ModuleDefinition.cs" />
    <!-- The rows the provider seed registers beside this slice's own: the module names their contracts, so the
         declaration they are read from is compiled here or the module does not build. -->
    <Compile Include="../../WeaponDeployableFactsContract.cs;../../WeaponMeleeHitContract.cs;../../AttackInstanceContract.cs" />
    <!-- `ModuleDefinition.Create` composes the ammunition and inventory row sets too, so their contracts are
         compiled here; this project exercises the override family only. -->
    <Compile Include="../../WeaponSupplyContract.cs;../../InventoryActionContract.cs" />
    <Compile Include="../../Actions/WeaponActionRuntime.cs" />
    <Compile Include="../../Native/WeaponOverrideApplier.cs;../../Native/WeaponActionAdapter.cs" />
    <Compile Include="WeaponOverrideTests.cs;WeaponOverrideContractTests.cs;WeaponActionTests.cs;WeaponOverrideWorld.cs;GameDoubles.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GTFOBepInExPath)/interop/Il2Cppmscorlib.dll" />
    <!-- The game types the applier names live in Modules-ASM; the doubles are what the compile binds, and the
         assembly is referenced so that a member this build does not have fails the build. -->
    <Reference Include="Modules-ASM" HintPath="$(GTFOBepInExPath)/interop/Modules-ASM.dll" />
    <Reference Include="GameData-ASM" HintPath="$(GTFOBepInExPath)/interop/GameData-ASM.dll" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(GTFOBepInExPath)/core/Il2CppInterop.Runtime.dll" />
    <Reference Include="SNet_ASM" HintPath="$(GTFOBepInExPath)/interop/SNet_ASM.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GTFOBepInExPath)/interop/UnityEngine.CoreModule.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
