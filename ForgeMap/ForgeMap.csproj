<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ForgeMap</AssemblyName>
    <RootNamespace>ForgeMap</RootNamespace>
    <Version>1.0.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <!-- Game-bound player identity lives in Native/ForgeMap.Native.csproj; this assembly stays game-independent. -->
    <Compile Remove="Native/**/*.cs" />
    <ProjectReference Include="../ForgeRuntime/Framework/ForgeRuntime.Framework.csproj" />
  </ItemGroup>
</Project>
