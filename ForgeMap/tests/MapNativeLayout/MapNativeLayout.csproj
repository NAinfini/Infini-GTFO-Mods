<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireCecil" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GTFOBepInExPath)/core/Mono.Cecil.dll')" Text="Set GTFOBepInExPath to an existing BepInEx folder." />
  </Target>
  <ItemGroup>
    <Reference Include="Mono.Cecil" HintPath="$(GTFOBepInExPath)/core/Mono.Cecil.dll" />
  </ItemGroup>
</Project>
