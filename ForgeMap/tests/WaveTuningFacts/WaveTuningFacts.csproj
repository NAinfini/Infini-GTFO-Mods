<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
  </PropertyGroup>
  <Target Name="RequireFramework" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;. This project is compiled against the framework's own assembly rather than against its sources, so it builds while another batch holds those sources mid-flight." />
  </Target>
  <ItemGroup>
    <!-- The tuning is a level field, not an action: the grammar that reads the package document is
         game-independent and owns every refusal, and `ForgeMap/Native/LevelWaveTuning` only writes the values the
         grammar approved. Nothing from `ForgeMap/Native` is compiled here, so the cases run without the game. -->
    <Compile Include="../../WaveTuningData.cs" />
    <Compile Include="AssemblyAttributes.cs;WaveTuningDataTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ForgeRuntime.Framework" />
  </ItemGroup>
</Project>
