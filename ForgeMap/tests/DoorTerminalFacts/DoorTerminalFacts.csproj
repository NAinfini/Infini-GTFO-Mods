<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- `GameDoubles.cs` deliberately declares the game types the production sources are compiled against, and
         the interop assembly is referenced so that a member this build does not have fails the build. Which
         definition wins is decided by the `Compile` list below, not by reference order. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;. The worktree's ForgeRuntime/Framework does not compile right now (VariableContracts.cs calls a Port(...) overload with a schema: argument the factory does not declare), so this project is built against the last good local copy." />
    <Error Condition="!Exists('$(GTFOBepInExPath)/interop/Modules-ASM.dll')"
      Text="Set GTFOBepInExPath or GTFO_BEPINEX_PATH to existing local compilation references." />
  </Target>
  <ItemGroup>
    <!-- The two contract files are the game-independent production sources under test: a case asserts the rows
         and bindings they declare, so a shape renamed on the production side fails here.
         The native sources are compiled in against the doubles: the facts half, its pure derivation, the
         publisher, the action half, the two readers it goes through and the outcome type are the real files, so
         a case exercises the production read, the production event building and the production refusal path.
         `DoorObservation` and `ZoneIndex` are doubles here because deriving an address from the level's zone
         table belongs to the observation slice and is covered by `tests/MapNativeAdapter`; the natives the
         derivation and the templates read are doubles, which is what makes "which member was reached" the
         assertion. -->
    <Compile Include="../../DoorTerminalEventContract.cs" />
    <Compile Include="../../DoorTerminalActionContract.cs" />
    <Compile Include="../../DoorQueryContract.cs" />
    <Compile Include="../../TerminalObjectContract.cs" />
    <Compile Include="../../MapObjectObservation.cs" />
    <!-- `MapObjectObservation` carries the zone section the trigger-zone package declares, so the contract that
         owns the type is compiled beside it, with the level identity its rows are filtered by. -->
    <Compile Include="../../TriggerZoneContract.cs" />
    <Compile Include="../../MapLevelReference.cs" />
    <Compile Include="../../Native/DoorTerminalDerivations.cs" />
    <Compile Include="../../Native/DoorTerminalPublisher.cs" />
    <Compile Include="../../Native/DoorTerminalFacts.cs" />
    <Compile Include="../../Native/DoorTerminalActions.cs" />
    <!-- `Native/TerminalActions.cs` is not compiled here: its command path reads members of
         `LG_ComputerTerminalManager` whose signatures name `GlobalManager`, so it needs GlobalFramework-ASM and a
         full terminal manager double. The line-kind mapping this slice derives is read instead, and the
         production terminal action layer is covered by `tests/TerminalObjectActions`. -->
    <Compile Include="../../Native/MapActionOutcome.cs" />
    <Compile Include="RegistryStubs.cs;AssemblyInfo.cs;GameDoubles.cs;World.cs;EventFacts.cs;ActionFacts.cs;QueryFacts.cs;ContractFacts.cs" />
    <!-- The one fixture that mounts a plan for a case whose observation point is the publisher's own hook: the
         gate has to have a subscriber before the publisher builds an event at all. -->
    <Compile Include="../Support/SubscriptionGateFixture.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GTFOBepInExPath)/interop/Il2Cppmscorlib.dll" />
    <Reference Include="Modules-ASM" HintPath="$(GTFOBepInExPath)/interop/Modules-ASM.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
