<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The two sources under test are game-independent by design: the zone document grammar and the tick that
         judges it read the kernel's own entity table and nothing of the game, so this project compiles them itself
         and needs no GTFO assembly at all. The one Framework reference is the kernel they are written against. -->
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
  </Target>
  <ItemGroup>
    <Compile Include="../../TriggerZoneContract.cs;../../TriggerZoneModule.cs;../../TriggerZoneSource.cs;../../TriggerZonePlacement.cs;../../MapLevelReference.cs" />
    <!-- A zone is a category of the map object's own namespace, so the cases run against the map-object half and
         not against a second publisher only tests have. -->
    <Compile Include="../../MapObjectObservation.cs;../../MapObjectModule.cs;../../MapObjectModule.Identity.cs;../../MapObjectContract.cs" />
    <!-- The map-object module is one declaration in three parts: the generator category lives in the third, which
         `MapObjectModule.cs` reads for its address table and its source. That half names the generator rows and the
         shared value-row reading, so both travel with it. -->
    <Compile Include="../../GeneratorMapObject.cs;../../GeneratorContract.cs;../../ValueRowReading.cs" />
    <Compile Include="../../TriggerZoneMapObject.cs" />
    <!-- The map-object half names one declaration member and one session half; `ZoneStubs.cs` carries exactly those
         two, the way the other focused projects carry the members their sources touch and nothing else. -->
    <Compile Include="../../MapIdentityContracts.cs" />
    <Compile Include="AssemblyAttributes.cs;TriggerZoneTests.cs;TriggerZoneWorld.cs;TriggerZonePlan.cs;ZoneStubs.cs" />
    <!-- The shared fixture that mounts a plan for a case whose observation point is the judging module's own
         hook: the gate has to have a subscriber before the module builds an event at all. -->
    <Compile Include="../Support/SubscriptionGateFixture.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
