<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The adapter compiles the native half's own sources, and those read the contract members ForgeMap spells
         as internals (a row's binding and handler are spelled once, in the contract). The name is the one
         ForgeMap/AssemblyInfo.cs grants that access to. -->
    <AssemblyName>ForgeMap.MapNativeAdapter.Tests</AssemblyName>
    <RootNamespace>ForgeMap.Tests.MapNativeAdapter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Production Map native sources compiled against loader/game doubles; no GTFO assembly is loaded. The list
         mirrors ForgeMap/Native/ForgeMap.Native.csproj one for one: a source the shipped native assembly compiles
         is a source this adapter compiles, so a reader or handler that only the adapter omits cannot hide behind
         the test project's shorter file list. -->
    <Compile Include="../../Native/Plugin.cs;../../Native/MapPluginSession.cs;../../Native/MapNativeHooks.cs;../../Native/PlayerIdentityModule.cs;../../Native/PlayerLifeFacts.cs;../../Native/PlayerObservation.cs;../../Native/PlayerSelector.cs;../../Native/PlayerHealthReceiver.cs;../../Native/PlayerHealthAction.cs;../../Native/MapObjectHooks.cs;../../Native/MapObjectSources.cs;../../Native/GeneratorSource.cs;../../Native/MapObjectHit.cs;../../Native/DoorObservation.cs;../../Native/TerminalObservation.cs;../../Native/ZoneIndex.cs;../../Native/LevelIdentity.cs;../../Native/ExpeditionHooks.cs;../../Native/MapActionOutcome.cs;../../Native/DoorActions.cs;../../Native/DoorActionCommands.cs;../../Native/TerminalActions.cs;../../Native/TerminalObjectActions.cs;../../Native/ObjectiveActions.cs;../../Native/ObjectiveActionHandler.cs;../../Native/AlarmWaveActions.cs;../../Native/PlayerActions.cs;../../Native/AgentModifierAdapter.cs;../../Native/AgentModifierValues.cs;../../Native/PlayerStateFacts.cs;../../Native/PlayerEventFacts.cs;../../Native/PlayerStateHooks.cs;../../Native/PlayerEventHooks.cs;../../Native/PlayerValueReads.cs;../../Native/PlayerNativeSources.cs;../../Native/PlayerCommandActions.cs;../../Native/PlayerSessions.cs;../../Native/EnvironmentActions.cs;../../Native/EnvironmentQuery.cs;../../Native/EnvironmentZoneTable.cs;../../Native/LightColorFade.cs;../../Native/MapClock.cs;../../Native/HudActions.cs;../../Native/TeammateOverhead.cs;../../Native/TeammateOverheadHooks.cs;../../Native/DoorTerminalDerivations.cs;../../Native/DoorTerminalPublisher.cs;../../Native/DoorTerminalFacts.cs;../../Native/DoorTerminalActions.cs;../../Native/DoorTerminalHooks.cs;../../Native/LevelObjectHooks.cs;../../Native/LevelObjectObservation.cs;../../Native/LevelEventHooks.cs;../../Native/LevelEventObservation.cs;../../Native/LevelEventActions.cs;../../Native/LevelObjectiveValueReader.cs;../../Native/TriggerZoneData.cs;../../Native/TriggerZoneCollision.cs;../../Native/TriggerZoneHooks.cs;../../Native/TriggerZoneRoomResolver.cs;../../Native/WorldEventActions.cs;../../Native/ObjectiveEventActions.cs;../../Native/InteractionTextActions.cs;../../Native/TerminalContentActions.cs;../../Native/LevelWaveTuning.cs;../../Native/GenericPlayerActions.cs;../../Native/MapStateActions.cs" />
    <Compile Include="AssemblyAttributes.cs;MapNativeAdapterTests.cs;MapObjectHitTests.cs;DoorTerminalActionTests.cs;SyntheticLevel.cs;GameDoubles.cs;NativeDoubles.cs;LoaderDoubles.cs" />
    <ProjectReference Include="../../ForgeMap.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
