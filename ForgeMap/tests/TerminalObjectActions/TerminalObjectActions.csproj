<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- `GameDoubles.cs` deliberately declares the game types the production action layer is compiled against, and
         the interop assembly is referenced so that a member this build does not have fails the build. Which
         definition wins is decided by the `Compile` list below, not by reference order. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">$(GTFO_BEPINEX_PATH)</GTFOBepInExPath>
  </PropertyGroup>
  <Target Name="RequireHostInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;." />
    <Error Condition="!Exists('$(GTFOBepInExPath)/interop/Modules-ASM.dll')"
      Text="Set GTFOBepInExPath or GTFO_BEPINEX_PATH to existing local compilation references." />
  </Target>
  <ItemGroup>
    <!-- The production sources under test, compiled against the game doubles. The terminal action layer, the two
         readers it goes through and the game-independent contract under test are the real files, so a case
         exercises the production read, the production write call and the rows the package really declares. The
         game-independent Map assembly is not referenced because this project must build on its own: the two
         constants the contract reads from it are declared in `RegistryStubs.cs` with the provider's own values. -->
    <Compile Include="../../TerminalObjectContract.cs" />
    <Compile Include="../../MapObjectObservation.cs" />
    <Compile Include="../../Native/TerminalObjectActions.cs" />
    <Compile Include="../../Native/TerminalActions.cs" />
    <Compile Include="../../Native/TerminalObservation.cs" />
    <Compile Include="../../Native/MapActionOutcome.cs" />
    <Compile Include="../../Native/ZoneIndex.cs" />
    <Compile Include="RegistryStubs.cs;World.cs;TerminalObjectActionsTests.cs;GameDoubles.cs" />
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(GTFOBepInExPath)/interop/Il2Cppmscorlib.dll" />
    <Reference Include="Modules-ASM" HintPath="$(GTFOBepInExPath)/interop/Modules-ASM.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
