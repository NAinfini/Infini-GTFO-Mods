<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ForgeMap.AgentModifierTests</AssemblyName>
    <RootNamespace>ForgeMap.Tests.AgentModifierFacts</RootNamespace>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- `GameDoubles.cs` deliberately declares the game types the production adapter is compiled against —
         `AgentModifier` and `AgentModifierManager` in the global namespace, exactly where the interop has them —
         so CS0436 fires on every mention of a shadowed type. No GTFO assembly is referenced: every native member
         this slice calls is part of its own double, and a member the real build does not have is checked by the
         native compile, not here. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The production sources under test, compiled against the doubles; no built ForgeMap.Native.dll is needed and
         no hook is installed. `PlayerIdentityModule` and `PlayerObservation` travel with them because the adapter
         resolves every recipient and every life through that one identity path. -->
    <Compile Include="../../Native/AgentModifierAdapter.cs;../../Native/AgentModifierValues.cs" />
    <Compile Include="../../Native/PlayerIdentityModule.cs;../../Native/PlayerObservation.cs" />
    <Compile Include="GameDoubles.cs;ModifierWorld.cs;Program.cs" />
    <!-- The capability rows, binding rows, support rows and handler shapes come from the game-independent Map
         assembly: the same declaration the runtime manifest, the website and the integration fragment read. -->
    <ProjectReference Include="../../ForgeMap.csproj" />
  </ItemGroup>
</Project>
