<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ForgeRuntimeFrameworkAssembly Condition="'$(ForgeRuntimeFrameworkAssembly)' == ''">$(MSBuildThisFileDirectory)../../../.artifacts/dotnet/bin/ForgeRuntime.Framework/release/ForgeRuntime.Framework.dll</ForgeRuntimeFrameworkAssembly>
  </PropertyGroup>
  <Target Name="RequireFramework" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ForgeRuntimeFrameworkAssembly)')"
      Text="Build ForgeRuntime/Framework/ForgeRuntime.Framework.csproj first, or pass -p:ForgeRuntimeFrameworkAssembly=&lt;path&gt;. This project is compiled against the framework's own assembly rather than against its sources, so it builds while another batch holds those sources mid-flight." />
  </Target>
  <ItemGroup>
    <!-- The contract under test is game-independent by design: it declares the three world-event rows and the one
         decision the condition action makes, and the native half only runs the call the decision approved. Nothing
         from `ForgeMap/Native` is compiled here, so the cases run without the game and without Harmony. -->
    <Compile Include="../../WorldEventContract.cs" />
    <Compile Include="../../ObjectiveEventContract.cs" />
    <Compile Include="AssemblyAttributes.cs;ProviderDeclaration.cs;WorldEventWorld.cs;WorldEventContractTests.cs;ObjectiveEventWorld.cs;ObjectiveEventTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ForgeRuntime.Framework" HintPath="$(ForgeRuntimeFrameworkAssembly)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ForgeRuntime.Framework" />
  </ItemGroup>
</Project>
