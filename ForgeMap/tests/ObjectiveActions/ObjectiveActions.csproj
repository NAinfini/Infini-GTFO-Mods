<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- `GameDoubles.cs` deliberately declares the game types the production layer is compiled against, so the
         shadowing warning every mention of one raises is expected here rather than a defect. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- One self-contained assembly: the runtime framework, the game-independent objective contract the rows are
         declared on, the production action layer and the doubles. Nothing is referenced from a built package, so
         this project builds and runs while other batches hold their own packages mid-flight. At integration time
         these same sources are the ones `ForgeRuntime.Framework.dll` and `ForgeMap.dll` ship, so the presentation
         tier is the framework's own file and not a hand-copied stand-in. -->
    <Compile Include="../../../ForgeRuntime/Framework/**/*.cs"
             Exclude="../../../ForgeRuntime/Framework/obj/**/*.cs" />
    <!-- The contract under test, compiled here rather than referenced from the package: a focused test must build
         and run on its own while other batches hold their packages mid-flight, and the only member of the
         provider declaration this slice's contract names is the provider id, which the doubles supply. -->
    <Compile Include="../../../ForgeMap/ObjectiveActionContract.cs" />
    <Compile Include="../../Native/MapActionOutcome.cs;../../Native/ObjectiveActions.cs;../../Native/ObjectiveActionHandler.cs" />
    <Compile Include="AssemblyAttributes.cs;Contexts.cs;ObjectiveActionsTests.cs;SyntheticWorld.cs;GameDoubles.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
