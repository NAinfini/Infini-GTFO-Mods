<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The three slice sources are compiled in as production sources, together with the two contract files they
         declare their rows on and the objective contract whose layer vocabulary they share. The runtime framework
         comes from its own project, so the tier rules and the registry a case exercises are the shipped ones. The
         provider declaration those contracts name is supplied by the doubles, because the Map package assembly is
         held by other batches' work in flight. -->
    <Compile Include="../../EnvironmentContract.cs;../../HudContract.cs;../../ObjectiveActionContract.cs" />
    <Compile Include="../../Native/EnvironmentActions.cs;../../Native/EnvironmentQuery.cs;../../Native/HudActions.cs" />
    <Compile Include="../../Native/PlayerSessions.cs;../../Native/TeammateOverhead.cs" />
    <Compile Include="AssemblyAttributes.cs;Contexts.cs;GameDoubles.cs;EnvironmentWorld.cs" />
    <Compile Include="EnvironmentActionTests.cs;EnvironmentPresentationTests.cs;EnvironmentHudTests.cs" />
    <Compile Include="EnvironmentOverheadTests.cs" />
    <Compile Include="EnvironmentQueryTests.cs;EnvironmentRegistrationTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../ForgeRuntime/Framework/ForgeRuntime.Framework.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
